# ==================== 微信小程序项目镜像 ====================
# 基于 miniprogram-ci-base 基础镜像
#
# 构建命令：
#   docker build -f Dockerfile.build \
#     --build-arg PROJECT_DIR="frontend-app" \
#     --build-arg BUILD_VERSION="1.0.0" \
#     --build-arg BUILD_DESC="功能更新" \
#     --build-arg BUILD_MODE="production" \
#     -t miniprogram:v1.0.0 \
#     .
#
# 运行命令：
#   docker run --rm \
#     -e MP_PRIVATE_KEY_URL="https://..." \
#     miniprogram:v1.0.0
#
# 注意：BUILD_MODE 在 build 时固化到镜像 /etc/build-mode，运行时不可
#       通过 `-e BUILD_MODE=...` 覆盖。需要切换 production / pre
#       请重新 build 镜像。

FROM artifacts.iflytek.com/cbg-docker-private/xfyun_webdev/miniprogram-ci-base:1.1.2

# ===== 构建参数 =====
ARG PROJECT_DIR=.
ARG BUILD_VERSION=""
ARG BUILD_DESC=""
ARG BUILDER=""
ARG ROBOT=""
ARG BUILD_MODE=production

# ===== BUILD_MODE 校验 + 固化到镜像（运行时不可改）=====
# 只允许 production / pre 两个值
# 写入 /etc/build-mode 后，docker-entrypoint.sh 优先读此文件，
# 忽略 `docker run -e BUILD_MODE=...` 的运行时覆盖。
RUN if [ "${BUILD_MODE}" != "production" ] && [ "${BUILD_MODE}" != "pre" ]; then \
        echo "ERROR: 非法 BUILD_MODE='${BUILD_MODE}'（仅允许 production / pre）" >&2; \
        exit 1; \
    fi && \
    echo "${BUILD_MODE}" > /etc/build-mode

# ===== 安装项目依赖 =====
COPY ${PROJECT_DIR}/package.json ${PROJECT_DIR}/package-lock.json ./
RUN npm ci --include=optional && \
    npm install @tarojs/binding-linux-x64-musl --save-optional --ignore-scripts 2>/dev/null || true

# ===== 复制 .git 目录（用于生成构建信息）=====
COPY .git /app/.git

# ===== 复制项目源码 =====
COPY ${PROJECT_DIR}/ ./

# ===== 生成构建信息并清理 .git =====
RUN node ${CI_SCRIPTS_PATH}/generate-build-info.js \
    --version "${BUILD_VERSION}" \
    --description "${BUILD_DESC}" \
    && rm -rf /app/.git

# ===== 环境变量（构建参数 -> 环境变量，运行时可覆盖）=====
# 注意：BUILD_MODE 不在此处暴露，由 docker-entrypoint.sh 从 /etc/build-mode 读取
ENV MP_PRIVATE_KEY_URL="" \
    ACTION="upload" \
    BUILD_VERSION="${BUILD_VERSION}" \
    BUILD_DESC="${BUILD_DESC}" \
    BUILD_ENV="development" \
    ROBOT=${ROBOT} \
    BUILDER="${BUILDER}" \
    UPLOAD_OSS="true"
